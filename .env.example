# DO NOT COMMIT REAL VALUES. Required:
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./kcs.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
OWNER_PASSWORD=replace-with-a-strong-unique-owner-password
# No intake until business, privacy, capacity, security, and insurance gates are approved:
INTAKE_ENABLED=false
# Second release gate; does not substitute for real operational/legal approvals:
KCS_RELEASE_APPROVED=false
# Optional. Without these, outbox remains pending and owner dashboard reports delivery unconfigured.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=

# Private staging: fail closed even if other intake flags are set
KCS_STAGING=false
# Bind to loopback; expose only through access-controlled tunnel/proxy
HOST=127.0.0.1
